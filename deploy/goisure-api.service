# /etc/systemd/system/goisure-api.service
[Unit]
Description=Goisure FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/goisure
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/uvicorn backend.server:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
Environment=MONGO_URL=mongodb://127.0.0.1:27017/
Environment=DB_NAME=goisure
Environment=JWT_SECRET=supersecretjwtkey123
Environment=PORT=8000

[Install]
WantedBy=multi-user.target